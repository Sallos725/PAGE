# PAGE 설정. 이 파일을 .env 로 복사해서 고친다. .env 는 커밋하지 않는다.

# 읽을 PocketRisu save 폴더 (risuai.db 가 있는 곳). 컨테이너에는 읽기 전용(:ro)으로만 붙는다.
PAGE_SAVE_DIR=/path/to/pocketrisu/save

# PAGE 데이터(서고 사본·읽기 상태·테마·글꼴). uid 1000 이 쓸 수 있어야 한다. 백업은 이 폴더만.
# 상대 경로는 docker-compose.yml 이 있는 폴더 기준.
PAGE_DATA_HOST_DIR=./page-data

# 호스트 포트와 여는 주소. 기본은 이 컴퓨터에서만(127.0.0.1).
# PAGE 에는 로그인이 없다 — 다른 기기에서 쓰려면 Tailscale·LAN 처럼 내 네트워크 안의 주소만 넣는다. 0.0.0.0 은 쓰지 않는다.
PAGE_HOST_PORT=6008
PAGE_HOST_BIND=127.0.0.1

# 이미지 버전 (업데이트할 때 바꾸고 docker compose pull && docker compose up -d).
PAGE_VERSION=1.1.0

# 시간대
TZ=Asia/Seoul

# EPUB·PDF 내보내기 그림 용량 한도(MB, 변환 뒤 크기). 기본 300.
# PAGE_EXPORT_IMAGE_BUDGET_MB=300
